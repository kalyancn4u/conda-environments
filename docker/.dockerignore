# Keep the build context small and reproducible. Paths are relative to the repo
# root (the build context these Dockerfiles expect).

# Version control & CI
.git/
.github/

# Built environments / local solver state (never belong in an image)
envs/
.conda/
.micromamba/
*.conda
*.tar.bz2
python/**/exports/

# Virtual environments
.venv/
.venv-*/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Notebooks / editors / OS cruft
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets — never copy these into an image
.env
.env.*

# Docs & local notes aren't needed at runtime (keeps images lean)
docs/
*.md
instructions.txt
