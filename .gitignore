# --- Conda / environments -------------------------------------------------
# Never commit built environments or local conda state.
envs/
.conda/
*.conda
*.tar.bz2

# Exported "current state" dumps (regenerate on demand, do not track)
python/**/exports/
*-frozen.yml
*-explicit.txt

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Jupyter --------------------------------------------------------------
.ipynb_checkpoints/

# --- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Secrets --------------------------------------------------------------
.env
.env.*
!.env.example

# Local prompt/scratch notes (not part of the published repository)
instructions.txt

# NOTE: lockfiles under python/**/lockfiles/ ARE tracked intentionally.
